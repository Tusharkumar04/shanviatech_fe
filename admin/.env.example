# Base URL of the backend API (Express server mounts admin routes under /api/v1)
VITE_API_URL=http://localhost:3001/api/v1

# Socket.IO server origin (survey chat popup realtime)
VITE_SOCKET_URL=http://localhost:3001

# Set to "true" to fall back to built-in dummy data when the backend is unreachable
VITE_ENABLE_MOCK_FALLBACK=true
